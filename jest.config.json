{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "./",
  "testEnvironment": "node",
  "testRegex": ".spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.test-support.ts",
    "!src/index.ts",
    "!src/**/entities/**"
  ],
  "coverageThreshold": {
    "global": {
      "lines": 90
    }
  }
}
