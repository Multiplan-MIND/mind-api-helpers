{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "API Helpers - Jest",
      "program": "${workspaceRoot}/node_modules/jest/bin/jest.js",
      "args": ["--verbose", "-i", "--no-cache"],
      "runtimeVersion": "24",
      "runtimeArgs": ["--experimental-vm-modules"],
      "sourceMaps": true,
      "cwd": "${workspaceRoot}",
      "console": "integratedTerminal"
    }
  ]
}
